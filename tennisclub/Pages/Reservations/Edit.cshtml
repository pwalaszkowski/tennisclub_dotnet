@page
@model tennisclub.Pages.Reservations.EditModel

@{
    ViewData["Title"] = "Edit Reservation";
}

<h1>Edit Reservation</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="CourtReservation.ReservationId" />

    <div class="form-group">
        <label asp-for="CourtReservation.ReservationDate" class="control-label">Reservation Date</label>
        <input asp-for="CourtReservation.ReservationDate" class="form-control" type="date" />
        <span asp-validation-for="CourtReservation.ReservationDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourtReservation.StartTime" class="control-label">Start Time</label>
        <input asp-for="CourtReservation.StartTime" class="form-control" type="time" />
        <span asp-validation-for="CourtReservation.StartTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourtReservation.EndTime" class="control-label">End Time</label>
        <input asp-for="CourtReservation.EndTime" class="form-control" type="time" />
        <span asp-validation-for="CourtReservation.EndTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourtReservation.Notes" class="control-label">Notes</label>
        <textarea asp-for="CourtReservation.Notes" class="form-control"></textarea>
        <span asp-validation-for="CourtReservation.Notes" class="text-danger"></span>
    </div>
    <br>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
