@page
@model tennisclub.Pages.Reservations.CreateModel
@{
    ViewData["Title"] = "Create New Reservation";
}

<h1>Create New Reservation</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="CourtReservation.UserId"></label>
        <select asp-for="CourtReservation.UserId" class="form-control" asp-items="Model.UsersSelectList"></select>
        <span asp-validation-for="CourtReservation.UserId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourtReservation.CourtId"></label>
        <select asp-for="CourtReservation.CourtId" class="form-control" asp-items="Model.CourtsSelectList"></select>
        <span asp-validation-for="CourtReservation.CourtId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourtReservation.ReservationDate"></label>
        <input asp-for="CourtReservation.ReservationDate" class="form-control" type="date" />
        <span asp-validation-for="CourtReservation.ReservationDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourtReservation.StartTime"></label>
        <input asp-for="CourtReservation.StartTime" class="form-control" type="time" />
        <span asp-validation-for="CourtReservation.StartTime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourtReservation.EndTime"></label>
        <input asp-for="CourtReservation.EndTime" class="form-control" type="time" />
        <span asp-validation-for="CourtReservation.EndTime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CourtReservation.Notes"></label>
        <textarea asp-for="CourtReservation.Notes" class="form-control"></textarea>
    </div>
    <br>
    <button type="submit" class="btn btn-primary">Create</button>
</form>