@page "./Delete/{id:int}"
@model tennisclub.Pages.Reservations.DeleteModel

<h1>Delete Reservation</h1>

<h3>Are you sure you want to delete this reservation?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Reservation ID
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.ReservationId
        </dd>
        <dt class="col-sm-2">
            User
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.User
        </dd>
        <dt class="col-sm-2">
            Court
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.Court
        </dd>
        <dt class="col-sm-2">
            Date
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.ReservationDate
        </dd>
        <dt class="col-sm-2">
            Start Time
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.StartTime
        </dd>
        <dt class="col-sm-2">
            End Time
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.EndTime
        </dd>
        <dt class="col-sm-2">
            Notes
        </dt>
        <dd class="col-sm-10">
            @Model.Reservation.Notes
        </dd>
    </dl>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>