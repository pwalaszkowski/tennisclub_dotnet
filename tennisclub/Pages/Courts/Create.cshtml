@page
@model tennisclub.Models.Court

<h1>Add Court</h1>

<form asp-page="Create" method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Location">Location</label>
        <input type="text" asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Surface">Surface</label>
        <select asp-for="Surface" class="form-control">
            <option value="Grass">Grass</option>
            <option value="Clay">Clay</option>
            <option value="Hard">Hard</option>
        </select>
        <span asp-validation-for="Surface" class="text-danger"></span>
    </div>
    <br>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="/Courts/Index" class="btn btn-secondary">Cancel</a>

</form>
