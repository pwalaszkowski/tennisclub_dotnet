@page
@model IndexModel

<h1>Courts</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Surface</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var court in Model.Courts)
        {
            <tr>
                <td>@court.Name</td>
                <td>@court.Location</td>
                <td>@court.Surface</td>
                <td>
                    <a asp-page="/Courts/Edit" asp-route-id="@court.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-page="/Courts/Delete" asp-route-id="@court.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="/Courts/Create" class="btn btn-primary">Add Court</a>
