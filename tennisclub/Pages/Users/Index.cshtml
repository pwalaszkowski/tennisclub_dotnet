@page
@model tennisclub.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users Index";
}

<h1>Welcome to Tennis Club Members Page</h1>

<p>The purpose of this page is to show the RazorBlade and MVP capabilities using .NET</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Membership Start Date</th>
            <th>Membership End Date</th>
            <th>Membership Type</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.MembershipStartDate</td>
                <td>@user.MembershipEndDate</td>
                <td>@user.MembershipType</td>
                
                <td>
                    <a asp-page="/Users/Edit" asp-route-id="@user.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-page="/Users/Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>