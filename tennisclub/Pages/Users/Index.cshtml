@page
@model tennisclub.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users Index";
}

<h1>Welcome to Tennis Club Members Page</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New User</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Date of Birth</th>
            <th>Membership Type</th>
            <th>Membership Start Date</th>
            <th>Membership End Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.DateOfBirth.ToShortDateString()</td>
                <td>@user.MembershipType</td>
                <td>@user.MembershipStartDate.ToShortDateString()</td>
                <td>@user.MembershipEndDate?.ToShortDateString() ?? "N/A"</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>